---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { jmpUrl } from '../lib/urls';

interface Props { paper: CollectionEntry<'papers'> }
const { paper } = Astro.props;
const d = paper.data;
const { Content } = await render(paper);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const links = [
  ...(d.pdf ? [{ label: d.type === 'publication' ? 'Paper' : 'Draft', url: d.jmp ? jmpUrl : d.pdf }] : []),
  ...d.links,
];
const hasDetail = Boolean(d.updated || d.venue || links.length);
const showStatus = Boolean(d.status) && links.length === 0;
const showMeta = hasDetail || showStatus;
---
<article class="paper" id={d.jmp ? 'jmp' : undefined}>
  {d.jmp && <p class="meta jmp">Job Market Paper</p>}
  <h3>{d.title}</h3>
  {d.coauthors && <p class="meta">with {d.coauthors}</p>}
  {showMeta && (
    <p class="meta">{
      [
        d.updated && `Last updated ${fmt(d.updated)}.`,
        d.venue && <><cite>{d.venue}</cite>{d.venueDate ? `, ${d.venueDate}` : ''}.</>,
        showStatus && d.status,
      ].filter(Boolean).map((part) => <> {part}</>)
    }{links.map((l) => <> <a href={l.url}>{l.label}</a>.</>)}</p>
  )}
  <details open={d.jmp}>
    <summary>Abstract</summary>
    <Content />
  </details>
</article>
