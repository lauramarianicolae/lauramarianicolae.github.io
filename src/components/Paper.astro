---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { basename } from 'node:path';
import { paperPdfUrl } from '../lib/pdfs.mjs';
import { arrow } from '../lib/arrow';

interface Props { paper: CollectionEntry<'papers'> }
const { paper } = Astro.props;
const d = paper.data;
const { Content } = await render(paper);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const pdfUrl = paperPdfUrl(basename(paper.filePath ?? `${paper.id}.md`));
const links = [
  ...(pdfUrl ? [{ label: d.type === 'publication' ? 'Paper' : 'Draft', url: pdfUrl }] : []),
  ...d.links,
];
const draft = d.jmp ? pdfUrl : undefined;
const hasDetail = Boolean(d.updated || d.venue || links.length);
const showStatus = Boolean(d.status) && links.length === 0;
const showMeta = hasDetail || showStatus;
---
<article class="paper" id={d.jmp ? 'jmp' : undefined}>
  {d.jmp && <p class="meta jmp">Job Market Paper</p>}
  <h3>{draft ? <a class="title-link" href={draft}>{d.title}</a> : d.title}</h3>
  {d.coauthors && <p class="meta">with {d.coauthors}</p>}
  {showMeta && (
    <p class="meta">{
      [
        d.updated && `Last updated ${fmt(d.updated)}.`,
        d.venue && <><cite>{d.venue}</cite>{d.venueDate ? `, ${d.venueDate}` : ''}.</>,
        showStatus && d.status,
      ].filter(Boolean).map((part) => <> {part}</>)
    }{links.map((l) => <> <a href={l.url}>{l.label}</a>.</>)}</p>
  )}
  <details open={d.jmp}>
    <summary>Abstract</summary>
    <div class="abstract"><Content />{draft && <p class="more"><a class="go" href={draft}>Read the latest draft<Fragment set:html={arrow} /></a></p>}</div>
  </details>
</article>
